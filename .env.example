# ==============================================================================
# LEDL Motor Energy Monitoring Platform — Environment Configuration
# M/s. Lakshmi Electrical Drives Pvt Ltd (LEDL), Energy Audit Department
# ==============================================================================
# Copy this file to .env and configure for your deployment:
#   cp .env.example .env
# ==============================================================================

# ── Application Settings ──────────────────────────────────────────────────────
PROJECT_NAME="LEDL Motor Energy Monitoring"
ENVIRONMENT=production
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=Asia/Kolkata

# ── Server & Network ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost","http://localhost:8080"]

# ── Security & Authentication ────────────────────────────────────────────────
# Generate a unique 32+ character secret, for example: openssl rand -hex 32
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
COOKIE_NAME=ledl_access_token

# ── Seeded Administrator Account ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=true

# ── IoT Device Ingestion Key ─────────────────────────────────────────────────
# Devices must include this header: X-Device-Key: <DEVICE_KEY>
DEVICE_KEY=ledl_secret_device_key_2026

# ── Database (PostgreSQL 16 + TimescaleDB + pgvector) ────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ledl_energy
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ledl_energy

# Fallback SQLite Database (used automatically during local development if Postgres is unavailable)
SQLITE_FALLBACK_URL=sqlite:///./data/ledl_energy.db
RAW_DATA_RETENTION_MONTHS=24

# ── AI / RAG Chatbot (OpenAI) ─────────────────────────────────────────────────
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
RAG_TOP_K=4

# ── Alerting & Notifications (Optional SMTP) ─────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@ledlenergy.com
